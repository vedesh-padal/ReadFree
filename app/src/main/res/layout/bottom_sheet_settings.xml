<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/toolbar_bg">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#555555"
        android:backgroundTint="#555555" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mirror Settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a preset mirror or enter your own URL."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- Preset options -->
    <RadioGroup
        android:id="@+id/radioGroupMirrors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioMirror1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="freedium.cfd"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent"
            android:tag="https://freedium.cfd/" />

        <RadioButton
            android:id="@+id/radioMirror2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="www.freedium.cfd"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent"
            android:tag="https://www.freedium.cfd/" />

        <RadioButton
            android:id="@+id/radioMirror3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="scribe.rip"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent"
            android:tag="https://scribe.rip/" />

        <RadioButton
            android:id="@+id/radioMirrorCustom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Custom URL"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent" />

    </RadioGroup>

    <!-- Custom URL input — only shown when "Custom" is selected -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/customUrlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://your-mirror.com/"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomMirrorUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyMirror"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply"
        android:padding="14dp"
        android:backgroundTint="@color/accent"
        android:layout_marginBottom="8dp" />

</LinearLayout>
