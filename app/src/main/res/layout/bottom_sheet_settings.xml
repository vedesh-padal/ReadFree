<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_bg">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#555555"
        android:backgroundTint="#555555" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a preset mirror or enter your own URL."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- Preset options -->
    <RadioGroup
        android:id="@+id/radioGroupMirrors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioMirrorDefault"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="freedium-mirror.cfd (Default)"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent"
            android:tag="https://freedium-mirror.cfd/" />

        <RadioButton
            android:id="@+id/radioMirrorCustom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Custom URL"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/accent" />
    </RadioGroup>

    <!-- Custom URL Input (Hidden by default) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/customUrlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Enter mirror URL (e.g. https://freedium.cfd/)"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomMirrorUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_tertiary"
        android:layout_marginVertical="24dp" />

    <!-- Raindrop.io Sync -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raindrop.io Integration"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync saved articles directly to your Raindrop account."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Raindrop Test Token"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRaindropToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRaindropSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Auto-Sync"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyMirror"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Settings"
        android:padding="12dp"
        android:backgroundTint="@color/accent" />

</LinearLayout>
